# Frontend env — copy to .env.local. Only NEXT_PUBLIC_ values; never put keys here (they ship to the browser).
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_MST_WS_URL=wss://testnetrpc.mstblockchain.com
# Official MST testnet explorer
NEXT_PUBLIC_EXPLORER=https://testnet.mstscan.com
# From deployments.md (B1)
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_USD_ADDRESS=
# Backend base URL (B1's Express app)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Sent as X-API-Key on every backend call. Ships to the browser, so it's app-level access control, not a secret.
NEXT_PUBLIC_API_KEY=
# Mock backend only (server-side, no NEXT_PUBLIC_): wallet addresses that sign in as the arbitrator, comma-separated
MOCK_ARBITRATORS=
# Endpoints to call live instead of mocks: comma-separated keys from lib/api.ts, or * for all
NEXT_PUBLIC_LIVE_ENDPOINTS=
# Server-side (no NEXT_PUBLIC_): serve the mock backend (/api/mock) in a production build, for demo deployments only
ENABLE_MOCK_BACKEND=false
