# Frontend env — copy to .env.local. Only NEXT_PUBLIC_ values; never put keys here (they ship to the browser).
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_MST_WS_URL=wss://testnetrpc.mstblockchain.com
# Testnet explorer URL still to be confirmed with mentors
NEXT_PUBLIC_EXPLORER=https://mstscan.com
# From deployments.md (B1)
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_USD_ADDRESS=
# Backend base URL
NEXT_PUBLIC_API_URL=http://localhost:4000
# Endpoints to call live instead of mocks: comma-separated keys from lib/api.ts, or * for all
NEXT_PUBLIC_LIVE_ENDPOINTS=
