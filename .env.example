# Copy to .env and fill in. NEVER commit .env. Testnet-only keys.

# --- MST testnet ---
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_WS_URL=wss://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037

# --- system wallets (B1 generates; backend only) ---
ORG_KEY=0x
AGENT_KEY=0x
ARBITRATOR_KEY=0x
AGENT_ADDRESS=0x
ARBITRATOR_ADDRESS=0x

# --- deployed contracts (from deployments.md) ---
USD_ADDRESS=0x
ESCROW_ADDRESS=0x
DEPLOY_BLOCK=0

# --- AI agent (B2; backend only) ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
AGENT_PROMPT_VERSION=v1
AGENT_DEMO_FALLBACK=false

# --- backend ---
PORT=4000
ADMIN_TOKEN=change-me
ONRAMP_INR_PER_USD=84

# --- frontend (public, no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=91562037
NEXT_PUBLIC_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_EXPLORER=
NEXT_PUBLIC_ESCROW_ADDRESS=0x
NEXT_PUBLIC_USD_ADDRESS=0x
