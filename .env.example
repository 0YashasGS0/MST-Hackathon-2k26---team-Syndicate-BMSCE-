# Copy to .env and fill in. NEVER commit .env. Testnet-only keys.

# --- MST testnet ---
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_WS_URL=wss://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037

# --- system wallets (B1 generates; backend only) ---
ORG_KEY=0x
AGENT_KEY=0x
ARBITRATOR_KEY=0x
AGENT_ADDRESS=0x
ARBITRATOR_ADDRESS=0x

# --- deployed contracts (from deployments.md) ---
USD_ADDRESS=0x
ESCROW_ADDRESS=0x
DEPLOY_BLOCK=0

# --- AI agent (B2; backend only) ---
LLM_PROVIDER=gemini         # "gemini" (default, @google/genai) or "anthropic"
LLM_API_KEY=                # key for the selected provider
LLM_MODEL=                  # run `npm run models` in backend/ to list valid Gemini model names
LLM_FALLBACK_MODELS=        # optional, comma-separated, tried in order on 429/500/503, e.g. gemini-3.7-flash,gemini-flash-latest,gemini-2.5-flash
LLM_MAX_COOLDOWN_WAIT_MS=65000  # if every model is rate-limited, wait at most this long once for the earliest; else fail fast
AGENT_PROMPT_VERSION=v3     # dispute prompt, FROZEN at v3 (per-criterion verdicts, code computes %); v1 | v2 still selectable
AGENT_DEMO_FALLBACK=false   # DEMO ONLY: rule demo-scenario SOWs with their ground truth, no LLM call (non-demo SOWs error)
AGENT_FALLBACK_ON_FAILURE=false  # DEMO ONLY: if every live model fails (quota/network), use the ground-truth fallback for demo SOWs
EVAL_RUNS=3                 # npm run eval:disputes: runs per scenario
EVAL_SCENARIOS=             # npm run eval:disputes: e.g. A,D (default all; D needs A for its injection check)
EVAL_DELAY_MS=7000          # npm run eval:disputes: wait between calls (a 429 retryDelay, up to 30 s, overrides it)
DEMO_BUYER=                 # npm run seed:demo: demo buyer wallet address
DEMO_SELLER=                # npm run seed:demo: demo seller wallet address
DEMO_REVIEW_SECS=120        # npm run seed:demo: review window for seeded SOWs (short, for the live demo)

# --- backend ---
PORT=4000
ADMIN_TOKEN=change-me
ONRAMP_INR_PER_USD=84

# --- frontend (public, no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=91562037
NEXT_PUBLIC_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_EXPLORER=
NEXT_PUBLIC_ESCROW_ADDRESS=0x
NEXT_PUBLIC_USD_ADDRESS=0x
