# ---- Chain (MST testnet) ----
MST_RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037
EXPLORER_URL=            # e.g. https://<mst-explorer>  (no trailing slash) - ask mentors
DEPLOY_BLOCK=0           # block of the escrow deployment; indexer backfills from here
ESCROW_ADDRESS=
USD_ADDRESS=

# ---- System wallet keys: NEVER commit, NEVER paste into any AI chat ----
ORG_KEY=
AGENT_KEY=
ARBITRATOR_KEY=

# ---- Frontend <-> backend auth ----
API_KEY=change-me-frontend-key       # frontend sends it as header  X-API-Key
ADMIN_TOKEN=change-me-admin-token    # admin/arbitrator routes: header  X-Admin-Token
CORS_ORIGINS=http://localhost:3000

# ---- Storage ----
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads

# ---- Integrations owned by others ----
B2_SCORER_URL=           # B2's scoreDispute endpoint (POST). Empty => local stub scorer
USE_STUB_SCORER=1        # 1 = hardcoded demo scores (flagged in reasoning). Formula+chain stay real
GAS_DRIP_MIN=0.05
GAS_DRIP_AMOUNT=0.1

# ---- Tuning ----
INDEXER_POLL_SECONDS=2
GAS_PRICE_GWEI=          # optional override; empty => node's gas_price
RUN_INDEXER=1

# ---- Demo wallets (seed script only; from `python -m scripts.gen_wallets`) ----
DEMO_BUYER_KEY=
DEMO_SELLER_KEY=
SEED_REVIEW_SECONDS=120
