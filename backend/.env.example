# --- MST testnet ---
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_WS_URL=wss://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037

# --- Contract addresses (fill after deploy, see deployments.md) ---
ESCROW_ADDRESS=0x
USD_ADDRESS=0x

# --- System wallet private keys (NEVER commit this file, only .env.example) ---
ORG_KEY=0x
AGENT_KEY=0x
ARBITRATOR_KEY=0x

# --- API key the frontend must send in the X-API-Key header ---
BACKEND_API_KEY=change-me-dev-key

# --- Separate token for the arbitrator console (POST /arbitrator/deals/:id/rule) ---
ADMIN_TOKEN=change-me-admin-token

# --- Block the indexer starts backfilling from (set to deploy block) ---
DEPLOY_BLOCK=0

PORT=5000

# --- Demo-only wallets used by scripts/seed.ts (never real funds) ---
DEMO_BUYER_KEY=0x
DEMO_SELLER_KEY=0x
