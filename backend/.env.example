# Backend env — copy to backend/.env (the backend loads .env from its working directory). NEVER commit .env.
# In production (NODE_ENV=production) the backend REFUSES TO START with dev auth, weak/missing secrets,
# a wildcard CORS or the demo fallbacks on — see docs/DEPLOY.md. Generate secrets with: openssl rand -hex 32
NODE_ENV=development
PORT=5000

# --- MST testnet ---
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_WS_URL=wss://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037

# --- Contract addresses (fill after deploy, see deployments.md) ---
ESCROW_ADDRESS=0x
USD_ADDRESS=0x
# Block the indexer starts backfilling from (set to the deploy block)
DEPLOY_BLOCK=0

# --- System wallet private keys (testnet only; secrets) ---
ORG_KEY=0x
AGENT_KEY=0x
ARBITRATOR_KEY=0x

# --- Storage ---
DB_PATH=./data/app.db

# --- Access control (secrets) ---
# App-level key the frontend sends in X-API-Key. It ships to the browser, so it is not per-user auth.
BACKEND_API_KEY=
# Operator/arbitrator console (X-Admin-Token): KYC approval, arbitration. Keep it off the frontend. >= 24 bytes.
ADMIN_TOKEN=
# PG sign-in: the frontend's host (checked inside the signed message) and the session HMAC key (>= 32 bytes).
AUTH_DOMAIN=localhost:3000
AUTH_URI=
AUTH_SESSION_SECRET=
# Wallets that get the arbitrator role in the app (arbitrator console; comma-separated). The operator can also use ADMIN_TOKEN.
ARBITRATOR_ADDRESSES=
# DEV/TESTS ONLY: trust the x-user-address header as the caller. Must be unset/false in production.
AUTH_DEV_HEADER=false
SARAL_ENABLED=false

# --- HTTP ---
# Exact frontend origins allowed to call the API with cookies (comma-separated). Required in production.
CORS_ORIGINS=http://localhost:3000
# Reverse-proxy hops in front of the backend (for the client IP used by rate limits), e.g. 1 behind Caddy/nginx.
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_EXPENSIVE_PER_MIN=10

# --- AI agent (B2) --- see docs/progress/B2.md "B2 env vars" for the full list
LLM_CHAIN=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
AGENT_PROMPT_VERSION=v4
DEFAULT_DELIVERY_DAYS=7
DEFAULT_REVIEW_SECS=172800
# DEMO ONLY (refused in production)
AGENT_DEMO_FALLBACK=false
AGENT_FALLBACK_ON_FAILURE=false

# --- Demo-only wallets used by scripts/seed.ts (never real funds) ---
DEMO_BUYER_KEY=0x
DEMO_SELLER_KEY=0x
